#!/usr/bin/make -f

export DH_VERBOSE = 1
export CARGO_HOME = $(CURDIR)/debian/.cargo

%:
	dh $@

override_dh_auto_configure:
	# Extract the release vendor archive into vendor/ before building.
	test -d vendor
	mkdir -p $(CARGO_HOME)
	printf '[source.crates-io]\nreplace-with = "vendored-sources"\n[source.vendored-sources]\ndirectory = "$(CURDIR)/vendor"\n' > $(CARGO_HOME)/config.toml

override_dh_auto_build:
	cargo build --locked --release --all-features --offline
	python3 scripts/third_party_notices.py --features all --offline

override_dh_auto_test:
	cargo test --locked --all-features --offline

override_dh_auto_install:
	# Handled by stamp-suite.install

override_dh_auto_clean:
	cargo clean
	rm -rf debian/.cargo
